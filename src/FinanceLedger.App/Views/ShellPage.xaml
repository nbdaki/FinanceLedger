<Page
    x:Class="FinanceLedger.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <muxc:NavigationView x:Name="Nav"
                         IsBackButtonVisible="Collapsed"
                         PaneDisplayMode="Left"
                         OpenPaneLength="220"
                         SelectionChanged="Nav_SelectionChanged">
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="概览" Tag="Dashboard" Icon="Home" />
            <muxc:NavigationViewItem Content="交易" Tag="Transactions" Icon="List" />
            <muxc:NavigationViewItem Content="账单导入" Tag="Import">
                <muxc:NavigationViewItem.Icon>
                    <muxc:FontIcon Glyph="&#xE898;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="账户" Tag="Accounts" Icon="Library" />
            <muxc:NavigationViewItem Content="投资" Tag="Investments">
                <muxc:NavigationViewItem.Icon>
                    <muxc:FontIcon Glyph="&#xE9D2;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
            <muxc:NavigationViewItem Content="负债与贷款" Tag="Liabilities" Icon="Calculator" />
            <muxc:NavigationViewItem Content="信用卡账单" Tag="Billing" Icon="Calendar" />
            <muxc:NavigationViewItem Content="设置" Tag="Settings" Icon="Setting" />
        </muxc:NavigationView.MenuItems>
        <muxc:NavigationView.FooterMenuItems>
            <muxc:NavigationViewItem Content="锁定账簿" Tag="Lock">
                <muxc:NavigationViewItem.Icon>
                    <muxc:FontIcon Glyph="&#xE72E;" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" Padding="28,24,28,24" />
    </muxc:NavigationView>
</Page>
