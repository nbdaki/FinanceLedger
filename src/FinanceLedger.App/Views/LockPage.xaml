<Page
    x:Class="FinanceLedger.App.Views.LockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6" Grid.Row="0">
            <TextBlock Text="个人财务台账" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="本地加密 · 无需登录 · 单账簿" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="24" CornerRadius="12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="14">
                <TextBlock x:Name="ModeTitle" Text="解锁账簿" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="HintText" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="输入账簿密码以继续。" />

                <StackPanel x:Name="UnlockPanel" Spacing="10">
                    <PasswordBox x:Name="PasswordBox" Header="账簿密码" PlaceholderText="输入密码（空密码直接点解锁）" />
                    <CheckBox x:Name="RecoveryToggle" Content="使用恢复码解锁" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="UnlockButton" Content="解锁" Style="{ThemeResource AccentButtonStyle}" Click="Unlock_Click" />
                        <Button x:Name="DeleteLedgerButton" Content="删除当前账簿" Click="DeleteLedger_Click" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="CreatePanel" Spacing="10" Visibility="Collapsed">
                    <TextBox x:Name="NameBox" Header="账簿名称" Text="我的账簿" />
                    <PasswordBox x:Name="NewPasswordBox" Header="设置密码（可留空）" PlaceholderText="留空则任何人都能打开" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Header="确认密码" PlaceholderText="空密码无需填写" />
                    <CheckBox x:Name="WeakPasswordAck" Content="我了解：空密码或少于 8 位的密码不提供有效保护" />
                    <Button x:Name="CreateButton" Content="创建账簿" Style="{ThemeResource AccentButtonStyle}" Click="Create_Click" />
                </StackPanel>

                <StackPanel x:Name="RecoveryPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock Text="请立即保存下面的恢复码，忘记密码时它是唯一凭证：" TextWrapping="Wrap" />
                    <TextBox x:Name="RecoveryCodeBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
                    <Button x:Name="EnterButton" Content="已保存，进入账簿" Style="{ThemeResource AccentButtonStyle}" Click="Enter_Click" />
                </StackPanel>

                <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="账簿文件仅保存在本机，忘记密码且丢失恢复码将无法恢复数据。"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
    </Grid>
</Page>
