<Page
    x:Class="FinanceLedger.App.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="账户" FontSize="26" FontWeight="SemiBold" />

        <Border Grid.Row="1" Padding="20" CornerRadius="12" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="14" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="账户名称" PlaceholderText="如：招商银行储蓄卡" />
                <ComboBox x:Name="KindCombo" Grid.Row="0" Grid.Column="1" Header="账户类型" DisplayMemberPath="Name" />
                <ComboBox x:Name="WalletCombo" Grid.Row="0" Grid.Column="2" Header="所属钱包" DisplayMemberPath="Name" />
                <TextBox x:Name="BalanceBox" Grid.Row="0" Grid.Column="3" Header="初始余额 / 欠款" PlaceholderText="0.00" />
                <Button x:Name="AddButton" Grid.Row="1" Grid.Column="0" Content="添加账户" Style="{ThemeResource AccentButtonStyle}" Click="Add_Click" />

                <ComboBox x:Name="ChooseCombo" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Name" PlaceholderText="选择账户校准余额" />
                <TextBox x:Name="NewBalanceBox" Grid.Row="1" Grid.Column="2" PlaceholderText="最新余额 / 欠款" />
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="10">
                    <Button Content="校准" Click="Adjust_Click" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <ListView x:Name="AccountList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Group}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                        <TextBlock Grid.Column="2" Text="{Binding KindName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding BalanceText}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
