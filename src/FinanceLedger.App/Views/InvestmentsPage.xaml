<Page
    x:Class="FinanceLedger.App.Views.InvestmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock Text="投资持仓" FontSize="26" FontWeight="SemiBold" />

            <Border Padding="20" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Tushare 行情" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TokenBox" Grid.Column="0" Header="Token（仅保存在加密账簿内）" PlaceholderText="粘贴 Tushare token" />
                        <Button x:Name="SaveTokenButton" Grid.Column="1" Content="保存" VerticalAlignment="Bottom" Click="SaveToken_Click" />
                        <Button x:Name="UpdatePricesButton" Grid.Column="2" Content="更新收盘价" VerticalAlignment="Bottom"
                                Style="{ThemeResource AccentButtonStyle}" Click="UpdatePrices_Click" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="CodeBox" Grid.Row="0" Grid.Column="0" Header="证券代码" PlaceholderText="600000 或 510300.SH" />
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Header="名称" />
                    <ComboBox x:Name="MarketCombo" Grid.Row="0" Grid.Column="2" Header="市场" DisplayMemberPath="Name" />
                    <ComboBox x:Name="AccountCombo" Grid.Row="0" Grid.Column="3" Header="证券资金账户" DisplayMemberPath="Name" />
                    <TextBox x:Name="QuantityBox" Grid.Row="1" Grid.Column="0" Header="数量" />
                    <TextBox x:Name="CostBox" Grid.Row="1" Grid.Column="1" Header="成本价" />
                    <TextBox x:Name="PriceBox" Grid.Row="1" Grid.Column="2" Header="现价（可留空）" />
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button x:Name="AddButton" Content="保存" Style="{ThemeResource AccentButtonStyle}" Click="Add_Click" />
                        <Button x:Name="UpdateButton" Content="改选记录" Click="Select_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <TextBlock Text="持仓明细" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="SavePriceButton" Content="手工更新选中价格" Click="SavePrice_Click" />
                    <Button x:Name="DeleteButton" Content="删除选中" Click="Delete_Click" />
                </StackPanel>
            </Grid>

            <ListView x:Name="HoldingList" SelectionMode="Single" MinHeight="160">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Code}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding QuantityText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding CostText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding PriceText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{Binding MarketValueText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="{Binding ProfitText}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
