<Page
    x:Class="FinanceLedger.App.Views.LiabilitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="负债与贷款" FontSize="26" FontWeight="SemiBold" />

        <Border Grid.Row="1" Padding="20" CornerRadius="12" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="14" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="0" Header="贷款名称" PlaceholderText="如：住房贷款" />
                <ComboBox x:Name="KindCombo" Grid.Row="0" Grid.Column="1" Header="类型" DisplayMemberPath="Name" />
                <TextBox x:Name="PrincipalBox" Grid.Row="0" Grid.Column="2" Header="原始本金" PlaceholderText="0.00" />
                <TextBox x:Name="RemainingBox" Grid.Row="0" Grid.Column="3" Header="剩余本金" PlaceholderText="0.00" />

                <TextBox x:Name="RateBox" Grid.Row="1" Grid.Column="0" Header="年利率（%）" PlaceholderText="如 3.5" />
                <TextBox x:Name="TermBox" Grid.Row="1" Grid.Column="1" Header="期限（月）" PlaceholderText="如 360" />
                <TextBox x:Name="MonthlyBox" Grid.Row="1" Grid.Column="2" Header="月供" PlaceholderText="0.00" />
                <TextBox x:Name="PaymentDayBox" Grid.Row="1" Grid.Column="3" Header="每月还款日" PlaceholderText="如 10" Text="10" />

                <Button x:Name="AddButton" Grid.Row="2" Grid.Column="0" Content="添加贷款" Style="{ThemeResource AccentButtonStyle}" Click="Add_Click" />
                <ComboBox x:Name="ChooseCombo" Grid.Row="2" Grid.Column="1" DisplayMemberPath="Name" PlaceholderText="选择贷款更新剩余本金" />
                <TextBox x:Name="NewRemainingBox" Grid.Row="2" Grid.Column="2" PlaceholderText="最新剩余本金" />
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Spacing="10">
                    <Button Content="更新" Click="Update_Click" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <ListView x:Name="LoanList" Grid.Row="2" SelectionMode="None" MaxHeight="200">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding KindName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding RemainingText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{Binding MonthlyText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding DayText}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <Border Padding="18" CornerRadius="12" BorderThickness="1" VerticalAlignment="Top"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="还款计划与提前还款" FontSize="16" FontWeight="SemiBold" />
                    <ComboBox x:Name="PlanLoanCombo" Header="贷款" DisplayMemberPath="Name" PlaceholderText="选择贷款" SelectionChanged="PlanLoanCombo_SelectionChanged" />
                    <TextBox x:Name="PrepayAmountBox" Header="提前还款金额" PlaceholderText="0.00" />
                    <DatePicker x:Name="PrepayDatePicker" Header="还款日期" />
                    <ComboBox x:Name="PrepayFundingCombo" Header="出资账户" DisplayMemberPath="Name" />
                    <CheckBox x:Name="ReduceTermCheck" Content="缩短期限（否则减少月供）" IsChecked="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="GenerateButton" Content="生成计划" Click="Generate_Click" />
                        <Button x:Name="PrepayButton" Content="提前还款" Style="{ThemeResource AccentButtonStyle}" Click="Prepay_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PlanStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="18" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="摊还明细" FontSize="16" FontWeight="SemiBold" />
                    <ListView x:Name="PaymentList" Grid.Row="1" SelectionMode="None" MaxHeight="420">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Period}" />
                                    <TextBlock Grid.Column="1" Text="{Binding DueText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding PaymentText}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding PrincipalText}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding InterestText}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
