<Page
    x:Class="FinanceLedger.App.Views.ImportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock Text="账单导入" FontSize="26" FontWeight="SemiBold" />

            <Border Padding="20" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathBox" Grid.Column="0" Header="支付宝 / 微信账单 CSV 路径" PlaceholderText="选择导出的 CSV 文件" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览" VerticalAlignment="Bottom" Click="Browse_Click" />
                        <Button x:Name="ImportButton" Grid.Column="2" Content="解析并导入待确认" VerticalAlignment="Bottom"
                                Style="{ThemeResource AccentButtonStyle}" Click="Import_Click" />
                    </Grid>
                    <CheckBox x:Name="RememberRulesCheck" Content="确认时记住商户分类规则" />
                    <ComboBox x:Name="BatchCombo" Header="导入批次" DisplayMemberPath="Name" PlaceholderText="全部批次" />
                    <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock Text="待确认记录" FontSize="16" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="ConfirmAllButton" Content="全部确认" Click="ConfirmAll_Click" />
                    <Button x:Name="UndoBatchButton" Content="撤销批次" Click="UndoBatch_Click" />
                </StackPanel>
            </Grid>

            <ListView x:Name="RowList" SelectionMode="Single" MinHeight="180" MaxHeight="360">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DateText}" />
                            <TextBlock Grid.Column="1" Text="{Binding TypeName}" />
                            <TextBlock Grid.Column="2" Text="{Binding Merchant}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding AmountText}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="{Binding StatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="{Binding ErrorText}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConfirmButton" Content="确认入账" Style="{ThemeResource AccentButtonStyle}" Click="Confirm_Click" />
                <Button x:Name="EditButton" Content="修改" Click="Edit_Click" />
                <Button x:Name="IgnoreButton" Content="忽略" Click="Ignore_Click" />
                <Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" />
            </StackPanel>

            <Border x:Name="EditPanel" Visibility="Collapsed" Padding="20" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="EditDateBox" Grid.Row="0" Grid.Column="0" Header="日期时间" PlaceholderText="yyyy-MM-dd HH:mm" />
                    <ComboBox x:Name="EditTypeCombo" Grid.Row="0" Grid.Column="1" Header="类型" DisplayMemberPath="Name" />
                    <TextBox x:Name="EditAmountBox" Grid.Row="0" Grid.Column="2" Header="金额" />
                    <TextBox x:Name="EditMerchantBox" Grid.Row="0" Grid.Column="3" Header="商户 / 对方" />
                    <ComboBox x:Name="EditCategoryCombo" Grid.Row="1" Grid.Column="0" Header="分类" DisplayMemberPath="Name" />
                    <ComboBox x:Name="EditFundingCombo" Grid.Row="1" Grid.Column="1" Header="出资账户" DisplayMemberPath="Name" />
                    <ComboBox x:Name="EditWalletCombo" Grid.Row="1" Grid.Column="2" Header="渠道余额账户" DisplayMemberPath="Name" />
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                        <Button Content="保存修改" Style="{ThemeResource AccentButtonStyle}" Click="SaveEdit_Click" />
                        <Button Content="取消" Click="CancelEdit_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
