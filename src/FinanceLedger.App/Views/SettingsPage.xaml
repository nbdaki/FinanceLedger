<Page
    x:Class="FinanceLedger.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold" />

            <Border Padding="20" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="投资市值（第一版手工更新）" FontSize="16" FontWeight="SemiBold" />
                    <TextBox x:Name="InvestmentBox" Header="证券持仓市值合计" PlaceholderText="0.00" />
                    <Button Content="保存" Click="SaveInvestment_Click" />
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="修改账簿密码" FontSize="16" FontWeight="SemiBold" />
                    <PasswordBox x:Name="OldPasswordBox" Header="当前密码" />
                    <PasswordBox x:Name="NewPasswordBox" Header="新密码（可留空）" PlaceholderText="留空则取消密码保护" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Header="确认新密码" />
                    <CheckBox x:Name="WeakPasswordAck" Content="我了解：空密码或少于 8 位的密码不提供有效保护" />
                    <Button Content="修改密码" Click="ChangePassword_Click" />
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="账簿信息" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="PathText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="恢复码仅在创建账簿时显示一次。忘记密码且丢失恢复码将无法恢复数据。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="立即锁定" Click="Lock_Click" />
                    <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
